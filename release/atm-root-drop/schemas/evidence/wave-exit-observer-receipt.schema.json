{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-atomic-framework.dev/evidence/wave-exit-observer-receipt.schema.json",
  "title": "ATM Wave-exit Observer Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "schemaVersion",
    "exitItemId",
    "wave",
    "observerActor",
    "observerRole",
    "declaredBasisActor",
    "independenceVerdict",
    "command",
    "exitCode",
    "stdoutDigest",
    "stderrDigest",
    "observedAt",
    "observedHead",
    "policyDigest",
    "inputDigests",
    "artifactPath"
  ],
  "properties": {
    "schemaId": { "const": "atm.waveExitObserverReceipt.v1" },
    "schemaVersion": { "type": "string", "minLength": 1 },
    "exitItemId": { "type": "string", "pattern": "^EXIT-[0-9]{2}$" },
    "wave": { "type": "string", "minLength": 1 },
    "observerActor": { "type": "string", "minLength": 1 },
    "observerRole": { "type": "string", "minLength": 1 },
    "declaredBasisActor": { "type": "string", "minLength": 1 },
    "independenceVerdict": { "const": "independent" },
    "command": { "type": "string", "minLength": 1 },
    "exitCode": { "type": "integer", "minimum": 0 },
    "stdoutDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "stderrDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "observedAt": { "type": "string", "minLength": 1 },
    "observedHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "policyDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "inputDigests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "artifactPath": { "type": "string", "minLength": 1 }
  }
}
