{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atm.sandboxedTestPatch.v1",
  "type": "object",
  "required": ["schemaId", "specVersion", "patchId", "authority", "sourceDigest", "operations", "minimizedOperationIds", "requiredTestIds", "passingTestIds", "provenance", "status", "diagnostics", "repairCommand", "resultDigest"],
  "properties": {
    "schemaId": { "const": "atm.sandboxedTestPatch.v1" },
    "specVersion": { "const": "0.1.0" },
    "patchId": { "type": "string", "minLength": 1 },
    "authority": {
      "type": "object",
      "required": ["authorityId", "baseDigest", "sealed"],
      "properties": { "authorityId": { "type": "string", "minLength": 1 }, "baseDigest": { "type": "string", "minLength": 1 }, "sealed": { "const": true } },
      "additionalProperties": false
    },
    "sourceDigest": { "type": "string", "minLength": 1 },
    "operations": { "type": "array" },
    "minimizedOperationIds": { "type": "array", "items": { "type": "string" } },
    "requiredTestIds": { "type": "array", "items": { "type": "string" } },
    "passingTestIds": { "type": "array", "items": { "type": "string" } },
    "provenance": { "type": "object" },
    "status": { "enum": ["proven", "blocked", "stale", "contradictory"] },
    "diagnostics": { "type": "array", "items": { "type": "string" } },
    "repairCommand": { "type": ["string", "null"] },
    "resultDigest": { "type": "string", "pattern": "^sha256:" }
  },
  "additionalProperties": false
}
