{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-atomic-framework.dev/schemas/evidence/concurrency-schedule-obligations.schema.json",
  "title": "ATM Concurrency Schedule Obligations Result",
  "type": "object",
  "required": ["schemaId", "specVersion", "scheduleId", "resultId", "authority", "status", "reducedSchedule", "independenceClasses", "obligations", "diagnostics", "provenance"],
  "additionalProperties": false,
  "properties": { "schemaId": { "const": "atm.concurrencyScheduleObligationsResult.v1" }, "specVersion": { "const": "0.1.0" }, "scheduleId": { "type": "string", "minLength": 1 }, "resultId": { "type": "string", "pattern": "^schedule_result_[0-9a-f]{16}$" }, "authority": { "$ref": "#/$defs/authority" }, "status": { "enum": ["reduced", "blocked", "unsupported", "stale"] }, "reducedSchedule": { "type": "array", "items": { "type": "string" } }, "independenceClasses": { "type": "array", "items": { "type": "object", "required": ["classId", "operationIds"], "additionalProperties": false, "properties": { "classId": { "type": "string" }, "operationIds": { "type": "array", "items": { "type": "string" } } } } }, "obligations": { "type": "array", "items": { "$ref": "#/$defs/obligation" } }, "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }, "provenance": { "type": "object", "required": ["inputDigest", "operationCount", "reductionCount"], "additionalProperties": false, "properties": { "inputDigest": { "type": "string" }, "operationCount": { "type": "integer", "minimum": 0 }, "reductionCount": { "type": "integer", "minimum": 0 } } } },
  "$defs": { "authority": { "type": "object", "required": ["authorityId", "sealed", "digest", "version"], "additionalProperties": false, "properties": { "authorityId": { "type": "string" }, "sealed": { "type": "boolean" }, "digest": { "type": "string" }, "version": { "type": ["string", "null"] } } }, "obligation": { "type": "object", "required": ["obligationId", "operationIds", "kind", "status"], "additionalProperties": false, "properties": { "obligationId": { "type": "string" }, "operationIds": { "type": "array", "items": { "type": "string" } }, "kind": { "enum": ["order", "conflict", "dependency"] }, "status": { "enum": ["satisfied", "blocked"] } } }, "diagnostic": { "type": "object", "required": ["code", "severity", "message", "ref", "repairCommand"], "additionalProperties": false, "properties": { "code": { "type": "string" }, "severity": { "enum": ["error", "warning"] }, "message": { "type": "string" }, "ref": { "type": ["string", "null"] }, "repairCommand": { "type": ["string", "null"] } } } }
}
