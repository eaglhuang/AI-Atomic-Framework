{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hist-v2-items/2",
  "title": "HIST-v2 classified item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "design_status",
    "id",
    "project",
    "set",
    "base",
    "target_file",
    "prs",
    "patches",
    "send_order",
    "hunk_ranges",
    "stratum",
    "min_dist",
    "write_class",
    "semantic_flag",
    "semantic_reasons",
    "test_purpose_code",
    "test_purpose",
    "correct_answer",
    "cluster_id",
    "fixed_test_ids",
    "grouping_codes",
    "labels",
    "concurrency_outcome",
    "commit_identities",
    "rules_sha256",
    "covariates",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "hist-v2-items/2"},
    "design_status": {"const": "draft-not-frozen-prereg"},
    "id": {"type": "string", "minLength": 1},
    "project": {"type": "string"},
    "set": {"type": "string"},
    "base": {"type": "string"},
    "target_file": {"type": "string"},
    "prs": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 4},
    "patches": {"type": "array", "minItems": 2, "maxItems": 4},
    "send_order": {"type": "array", "items": {"type": "integer"}},
    "hunk_ranges": {"type": "array"},
    "stratum": {"enum": ["O1", "O2", "O3", null]},
    "min_dist": {"type": ["integer", "null"], "minimum": 0},
    "write_class": {"enum": ["A", "B", "C", "A'", "B'", "D", null]},
    "semantic_flag": {"enum": ["S", "N"]},
    "semantic_reasons": {"type": "array", "items": {"type": "string"}},
    "test_purpose_code": {"type": "string"},
    "test_purpose": {"type": "string"},
    "correct_answer": {"type": "object"},
    "cluster_id": {"type": "string"},
    "fixed_test_ids": {"type": "array", "items": {"type": "string"}},
    "grouping_codes": {
      "type": "array",
      "items": {
        "enum": [
          "shared-pr-component-leak",
          "identical-patch-leak",
          "cherry-pick-leak",
          "backport-leak"
        ]
      }
    },
    "labels": {"type": "array", "items": {"type": "string"}},
    "concurrency_outcome": {"type": "string"},
    "commit_identities": {"type": "object"},
    "rules_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "covariates": {"type": "object"},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
