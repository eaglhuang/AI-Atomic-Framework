+#!/usr/bin/env bash
+# r4 validation of ATM PR #214 (merge 2118bc66; steward completion-rate optimizations) — harness-only; all ATM pins read-only.
+# Same E4 config/seeds as r3. Arms (interleaved per run, same session/machine):
