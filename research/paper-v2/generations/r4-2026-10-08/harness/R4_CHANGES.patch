+  node test/r4_fault_scenarios.mjs --pins "2118bc66=$OPT,bea35380=$FIX" --out "$D/faults" --reps "$FAULT_REPS" > "$D/faults/summary.stdout.json" 2> "$D/faults/progress.log" && rc=0 || rc=$?
+  echo "faults rc=$rc" >> "$LOG";;
+esac; done
+echo "end $(date '+%F %T %Z')" >> "$LOG"
