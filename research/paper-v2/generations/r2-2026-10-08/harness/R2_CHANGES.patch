+const OUT = process.argv[2] || join(HERE, '..', 'runs', 'r2-oracle-contract');
+
+const BASE = [
+  '// fixture header',            // 1
+  '// <region:r1>',               // 2
+  'const a = 1;',                 // 3
+  '// </region:r1>',              // 4
+  'const mid = 2;',               // 5
+  '// <region:r2>',               // 6
+  'const b = 3;',                 // 7
+  '// </region:r2>',              // 8
+  '',
+].join('\n');
+const L1 = '// atm-edit c-i1 by agent:x';
+const L2 = '// atm-edit c-i2 by agent:y';
+const L3 = '// atm-edit c-i3 by agent:z';
