{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-atomic-framework.dev/schemas/evidence/governance-model-adapters.schema.json",
  "title": "ATM Governance Model Adapters Result",
  "type": "object",
  "required": ["schemaId", "specVersion", "runId", "resultId", "authority", "status", "projections", "diagnostics", "provenance"],
  "additionalProperties": false,
  "properties": { "schemaId": { "const": "atm.governanceModelAdaptersResult.v1" }, "specVersion": { "const": "0.1.0" }, "runId": { "type": "string", "minLength": 1 }, "resultId": { "type": "string", "pattern": "^governance_adapters_[0-9a-f]{16}$" }, "authority": { "$ref": "#/$defs/authority" }, "status": { "enum": ["adapted", "blocked", "stale", "unsupported"] }, "projections": { "type": "array", "items": { "$ref": "#/$defs/projection" } }, "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }, "provenance": { "type": "object", "required": ["inputDigest", "modelCount", "adapterKinds"], "additionalProperties": false, "properties": { "inputDigest": { "type": "string" }, "modelCount": { "type": "integer", "minimum": 0 }, "adapterKinds": { "type": "array", "items": { "type": "string" } } } } },
  "$defs": { "authority": { "type": "object", "required": ["authorityId", "sealed", "digest", "version"], "additionalProperties": false, "properties": { "authorityId": { "type": "string" }, "sealed": { "type": "boolean" }, "digest": { "type": "string" }, "version": { "type": ["string", "null"] } } }, "projection": { "type": "object", "required": ["projectionId", "modelId", "kind", "canonicalState", "owner", "attributes"], "additionalProperties": false, "properties": { "projectionId": { "type": "string" }, "modelId": { "type": "string" }, "kind": { "enum": ["task", "lane", "broker", "close", "runner"] }, "canonicalState": { "type": "string" }, "owner": { "type": ["string", "null"] }, "attributes": { "type": "object" } } }, "diagnostic": { "type": "object", "required": ["code", "severity", "message", "ref", "repairCommand"], "additionalProperties": false, "properties": { "code": { "type": "string" }, "severity": { "enum": ["error", "warning"] }, "message": { "type": "string" }, "ref": { "type": ["string", "null"] }, "repairCommand": { "type": ["string", "null"] } } } }
}
